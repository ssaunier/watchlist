{
  "name": "watchlist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "preview": "npm run build:production && vite preview",
    "deploy": "npm run build:production && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:migrate:local": "wrangler d1 migrations apply watchlist-dev --local",
    "db:migrate:production": "wrangler d1 migrations apply watchlist-production --remote --env production",
    "types": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "hono": "^4.13.8",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
